###############################################################################
# APLICACAO
# APP_TIMEZONE e SEMPRE UTC (R2). A conversao para o fuso do cliente acontece
# apenas na camada de apresentacao, via display_datetime().
###############################################################################
APP_NAME="Recjota"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seudominio.com.br
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

###############################################################################
# BANCO DE DADOS - MySQL 8 / MariaDB 10.11+ (InnoDB, utf8mb4_unicode_ci)
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_recjota
DB_USERNAME=uXXXXXXXX_recjota
DB_PASSWORD=

###############################################################################
# DRIVERS - sem Redis/Memcached na hospedagem compartilhada (R10)
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# E-MAIL - SMTP Hostinger (configurar SPF, DKIM e DMARC no dominio)
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_THROTTLE_PER_MINUTE=20

###############################################################################
# AGENCIA
###############################################################################
AGENCY_NAME="Recjota"
AGENCY_DEFAULT_TIMEZONE=America/Sao_Paulo
AGENCY_PRIMARY_COLOR="#4F46E5"
AGENCY_SUPPORT_EMAIL="contato@seudominio.com.br"

# Porta de emergência do console de manutenção (/manutencao), para quando não
# há SSH e o login quebrou. Deixe VAZIO no dia a dia; preencha com 64
# caracteres aleatórios só enquanto precisar, e apague em seguida.
MAINTENANCE_TOKEN=

###############################################################################
# INSTAGRAM - Instagram API with Instagram Login (graph.instagram.com) - Fase 4
###############################################################################
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI="${APP_URL}/oauth/instagram/callback"
IG_API_VERSION=v23.0
IG_WEBHOOK_VERIFY_TOKEN=

###############################################################################
# GOOGLE DRIVE - escopo drive.file + Picker API - Fase 5
###############################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

###############################################################################
# MICROSOFT ONEDRIVE / SHAREPOINT - Entra ID + File Picker v8 - Fase 5
###############################################################################
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI="${APP_URL}/oauth/microsoft/callback"

###############################################################################
# PONTE DE MIDIA PUBLICA - Fase 4 (Secao 7.4)
###############################################################################
MEDIA_BRIDGE_PATH=/home/uXXXXXXXX/domains/seudominio.com.br/public_html/media-tmp
MEDIA_BRIDGE_URL="${APP_URL}/media-tmp"
MEDIA_BRIDGE_TTL_HOURS=6

VITE_APP_NAME="${APP_NAME}"
