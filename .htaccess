# Modo pasta única: o projeto INTEIRO dentro da pasta publicada.
#
# O layout recomendado continua sendo o de duas pastas, com o código fora do
# document root (DEPLOY.md). Mas se o projeto acabar aqui dentro — por engano
# ou por escolha — este arquivo faz duas coisas:
#
#   1. fecha o acesso a tudo que não é público (.env, vendor, storage, config…);
#   2. encaminha as requisições para public/, de modo que o site FUNCIONE.
#
# Negar tudo seria mais simples, mas transforma um erro de posicionamento num
# 403 mudo, que é impossível de diagnosticar sem acesso ao servidor.

DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

# Arquivos que nunca podem ser servidos, estejam onde estiverem.
<FilesMatch "^(\.env.*|\.git.*|\.htaccess|\.user\.ini|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|pint\.json|cron\.(sh|php))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Força HTTPS (Seção 10).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pastas internas do projeto: 403 seco, sem revelar o que há dentro.
    RewriteRule ^(app|bootstrap|config|database|deploy|dist|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Cabeçalho Authorization (APIs).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Arquivo real que vive em public/ (CSS, JS, imagens) é servido de lá.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Todo o resto vai para o front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
